    {
      "id": "remaining_t1",
      "label": "Drivers remaining after the first call-up count",
      "formula": "drivers_total - mob_t1",
      "value": 75,
      "text": "75",
      "unit": "drivers"
    },
    {
      "id": "shortfall_t1",
      "label": "Trucks below the Aurelia minimum with the first call-up count",
      "formula": "max(0, min_trucks - min(trucks_total, remaining_t1))",
      "value": 5,
      "text": "5",
      "unit": "trucks"
    },
    {
      "id": "penalty_day_t1",
      "label": "Daily penalty with the first call-up count",
      "formula": "shortfall_t1 * penalty_rate",
      "value": 2000,
      "text": "2,000",
      "unit": "€/day"
    },
    {
      "id": "penalty_30_t1",
      "label": "Penalty over 30 days with the first call-up count",
      "formula": "penalty_day_t1 * 30",
      "value": 60000,
      "text": "60,000",
      "unit": "€"
    },
    {
      "id": "cover_day_t1",
      "label": "Daily cost of covering the gap with the subcontractor (first call-up count)",
      "formula": "shortfall_t1 * offer_rate",
      "value": 1450,
      "text": "1,450",
      "unit": "€/day"
    },
    {
      "id": "saving_day_t1",
      "label": "Daily saving of subcontracting versus paying penalties (first call-up count)",
      "formula": "penalty_day_t1 - cover_day_t1",
      "value": 550,
      "text": "550",
      "unit": "€/day"
    },
    {
      "id": "offer_full_day",
      "label": "Daily cost of taking the whole subcontractor offer",
